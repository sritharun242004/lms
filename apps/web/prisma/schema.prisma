// ============================================================================
// AI Empowerment CMS — Prisma Schema
// PostgreSQL · Prisma v6 · Fully Normalized
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  ADMIN
  MENTOR
  MENTEE
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum MemberRole {
  OWNER
  MENTOR
  MENTEE
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  ANNOUNCEMENT
  POLL
  OPEN_QUESTION
  WORD_CLOUD
  SCALE
  FORM
}

enum PollChartType {
  BAR
  DONUT
  PIE
}

enum QuestionLibraryType {
  MULTIPLE_CHOICE
  WORD_CLOUD
  OPEN_ENDED
  SCALE
}

// ============================================================================
// 1. User
// ============================================================================

model User {
  id                  String     @id @default(cuid())
  name                String
  // Guest mentees (joined via name + invite code, no account) have no
  // email or password — only mentors/admins and legacy full mentee
  // signups do. Postgres allows multiple NULLs in a unique column, so
  // any number of guest mentees can coexist.
  email               String?    @unique
  phone               String?    @unique
  password            String?
  role                UserRole   @default(MENTEE)
  isActive            Boolean    @default(true) @map("is_active")
  authVersion         Int        @default(0) @map("auth_version")
  disabledAt          DateTime?  @map("disabled_at")
  // Set only for guest mentees, from the request IP at join time. Used
  // server-side to avoid creating a duplicate mentee record when the same
  // device re-submits the join form for a group it's already in — never
  // selected into any client-facing response.
  ipAddress           String?    @map("ip_address")
  bio                 String?
  avatarUrl           String?    @map("avatar_url")
  status              UserStatus @default(OFFLINE)
  lastSeenAt          DateTime?  @map("last_seen_at")
  emailVerified       Boolean    @default(false) @map("email_verified")
  emailVerifyToken    String?    @map("email_verify_token")
  passwordResetToken  String?    @map("password_reset_token")
  passwordResetExpiry DateTime?  @map("password_reset_expiry")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // Relations
  groups               GroupMember[]
  sentMessages         Message[]              @relation("MessageSender")
  deletedMessages      Message[]              @relation("MessageDeleter")
  refreshTokens        RefreshToken[]
  sessions             Session[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  createdGroups        Group[]
  createdInviteCodes   InviteCode[]
  messageEdits         MessageHistory[]
  pollVotes            PollVote[]
  openAnswers          OpenAnswer[]
  wordCloudSubmissions WordCloudSubmission[]
  scaleResponses       ScaleResponse[]
  approvedCoachEmails  CoachEmailApproval[]   @relation("CoachApprovalAdmin")
  claimedCoachApproval CoachEmailApproval?    @relation("CoachApprovalClaim")
  savedQuestions       QuestionLibraryItem[]
  profilePhoto         UserProfilePhoto?
  promptMatrices       PromptMatrix[]         @relation("PromptMatrixCreator")
  promptBotSessions    PromptBotSession[]     @relation("PromptBotSessionOwner")
  aiUsage              AiUsageDaily[]         @relation("AiUsageOwner")
  skillPacks           SkillPack[]            @relation("SkillPackOwner")
  skillCatalogEntries  SkillCatalogEntry[]    @relation("SkillCatalogCreator")
  skillJobs            SkillJob[]             @relation("SkillJobOwner")
  themePreference      String?                @map("theme_preference")
  createdForms         Form[]
  questionTemplates    FormQuestionTemplate[]
  formInvitations      FormInvitation[]
  formResponses        FormResponse[]

  @@map("users")
}

model QuestionLibraryItem {
  id              String                          @id @default(cuid())
  name            String                          @default("Untitled quiz")
  question        String
  type            QuestionLibraryType             @default(MULTIPLE_CHOICE)
  chartType       PollChartType                   @default(BAR) @map("chart_type")
  createdById     String                          @map("created_by_id")
  createdAt       DateTime                        @default(now()) @map("created_at")
  updatedAt       DateTime                        @updatedAt @map("updated_at")
  createdBy       User                            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options         QuestionLibraryOption[]
  scaleStatements QuestionLibraryScaleStatement[]

  @@index([createdById])
  @@index([name])
  @@index([type])
  @@map("question_library_items")
}

model QuestionLibraryOption {
  id         String              @id @default(cuid())
  questionId String              @map("question_id")
  text       String
  order      Int
  question   QuestionLibraryItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("question_library_options")
}

// Reusable Scale template statements. A template is only a draft: publishing
// copies these rows into ScaleStatement, so later edits never touch live data.
model QuestionLibraryScaleStatement {
  id         String              @id @default(cuid())
  questionId String              @map("question_id")
  text       String
  order      Int
  max        Int                 @default(5)
  question   QuestionLibraryItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("question_library_scale_statements")
}

model CoachEmailApproval {
  id           String    @id @default(cuid())
  email        String    @unique
  approvedById String    @map("approved_by_id")
  claimedById  String?   @unique @map("claimed_by_id")
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  approvedBy User  @relation("CoachApprovalAdmin", fields: [approvedById], references: [id], onDelete: Restrict)
  claimedBy  User? @relation("CoachApprovalClaim", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([approvedById])
  @@map("coach_email_approvals")
}

// ============================================================================
// 2. RefreshToken
// ============================================================================

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// 3. Session
// ============================================================================

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  isActive     Boolean  @default(true) @map("is_active")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

// ============================================================================
// 4. Group
// ============================================================================

model Group {
  id           String   @id @default(cuid())
  name         String
  description  String?
  wallpaperUrl String?  @map("wallpaper_url")
  avatarUrl    String?  @map("avatar_url")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members      GroupMember[]
  messages     Message[]
  inviteCodes  InviteCode[]
  profilePhoto GroupProfilePhoto?

  @@index([createdById])
  @@map("groups")
}

// ============================================================================
model UserProfilePhoto {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  mimeType  String   @map("mime_type")
  size      Int
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_photos")
}

model GroupProfilePhoto {
  id        String   @id @default(cuid())
  groupId   String   @unique @map("group_id")
  mimeType  String   @map("mime_type")
  size      Int
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_profile_photos")
}

// 5. GroupMember
// ============================================================================

model GroupMember {
  id       String     @id @default(cuid())
  userId   String     @map("user_id")
  groupId  String     @map("group_id")
  role     MemberRole @default(MENTEE)
  joinedAt DateTime   @default(now()) @map("joined_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}

// ============================================================================
// 6. Message
// ============================================================================

/// Full-text search: CREATE INDEX messages_content_search_idx ON messages USING GIN (to_tsvector('english', content));
model Message {
  id             String      @id @default(cuid())
  content        String
  type           MessageType @default(TEXT)
  groupId        String      @map("group_id")
  senderId       String      @map("sender_id")
  attachmentUrl  String?     @map("attachment_url")
  attachmentName String?     @map("attachment_name")
  isPinned       Boolean     @default(false) @map("is_pinned")
  isEdited       Boolean     @default(false) @map("is_edited")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  deletedAt      DateTime?   @map("deleted_at")
  deletedById    String?     @map("deleted_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender          User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  deletedBy       User?              @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  editHistory     MessageHistory[]
  poll            Poll?
  openQuestion    OpenQuestion?
  wordCloud       WordCloud?
  scale           Scale?
  attachment      MessageAttachment?
  formInvitations FormInvitation[]

  @@index([groupId, createdAt])
  @@index([senderId])
  @@index([deletedById])
  @@index([isPinned])
  @@index([type])
  @@map("messages")
}

// ============================================================================
// 6a. MessageAttachment
// ============================================================================

// Uploaded file bytes for a FILE-type message, stored in Postgres so no
// external object storage is required. `data` is kept out of every normal
// message list query (messageSelect only pulls mimeType/size) — it's read
// only when the download route streams this single row back.
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String   @unique @map("message_id")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

// ============================================================================
// 7. MessageHistory
// ============================================================================

model MessageHistory {
  id              String   @id @default(cuid())
  messageId       String   @map("message_id")
  previousContent String   @map("previous_content")
  editedById      String   @map("edited_by_id")
  version         Int
  editedAt        DateTime @default(now()) @map("edited_at")

  // Relations
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedBy User    @relation(fields: [editedById], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([editedById])
  @@map("message_history")
}

// ============================================================================
// 7b. Poll — a live, votable multiple-choice message (Mentimeter-style)
// ============================================================================

model Poll {
  id            String        @id @default(cuid())
  messageId     String        @unique @map("message_id")
  question      String
  chartType     PollChartType @default(BAR) @map("chart_type")
  allowMultiple Boolean       @default(false) @map("allow_multiple")
  isClosed      Boolean       @default(false) @map("is_closed")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  // No separate createdById — the linked message's sender is the poll's
  // creator (same ownership check already used for editing/deleting a
  // regular message covers polls too, since a poll is just a message).
  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  text   String
  order  Int

  // Relations
  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique per (option, user) rather than (poll, user) — this is what
  // lets `allowMultiple` polls record one row per option a user picks.
  // Single-choice polls enforce "one active vote" at the application
  // layer instead: casting a new vote deletes the user's other rows
  // for that poll first.
  @@unique([optionId, userId])
  @@index([pollId])
  @@index([userId])
  @@map("poll_votes")
}

// ============================================================================
// 7c. OpenQuestion — a free-text prompt where answers stack up live as a
// wall of anonymous cards (Mentimeter "Open Ended" style), rather than
// a bar/pie of counted options.
// ============================================================================

model OpenQuestion {
  id        String   @id @default(cuid())
  messageId String   @unique @map("message_id")
  question  String
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations — same "no createdById" reasoning as Poll: the linked
  // message's sender is the question's creator.
  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  answers OpenAnswer[]

  @@map("open_questions")
}

model OpenAnswer {
  id             String   @id @default(cuid())
  openQuestionId String   @map("open_question_id")
  userId         String   @map("user_id")
  text           String
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  openQuestion OpenQuestion @relation(fields: [openQuestionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One answer per user per question — resubmitting updates this row
  // (its position in the wall stays put, ordered by original createdAt)
  // rather than adding a duplicate card.
  @@unique([openQuestionId, userId])
  @@index([openQuestionId])
  @@map("open_answers")
}

// ============================================================================
// 7d. WordCloud — a live-aggregated word cloud (Mentimeter-style). Every
// submission is normalized and merged into a per-word frequency count
// rather than displayed as a separate item, so the cloud never shows
// duplicate words.
// ============================================================================

model WordCloud {
  id                       String   @id @default(cuid())
  messageId                String   @unique @map("message_id")
  question                 String
  maxWordsPerParticipant   Int      @default(1) @map("max_words_per_participant")
  maxWordLength            Int      @default(200) @map("max_word_length")
  allowMultipleSubmissions Boolean  @default(false) @map("allow_multiple_submissions")
  profanityFilter          Boolean  @default(true) @map("profanity_filter")
  isLocked                 Boolean  @default(false) @map("is_locked")
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations — same "no createdById" reasoning as Poll/OpenQuestion.
  message     Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entries     WordCloudEntry[]
  submissions WordCloudSubmission[]

  @@map("word_clouds")
}

model WordCloudEntry {
  id          String   @id @default(cuid())
  wordCloudId String   @map("word_cloud_id")
  // Normalized (trimmed, punctuation-stripped) submitted form — this is
  // the case-sensitive value duplicate detection matches against.
  text        String
  count       Int      @default(1)
  // Assigned once, at first submission, and never recomputed — a word's
  // color must stay fixed for the life of the cloud.
  color       String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  // Relations
  wordCloud   WordCloud             @relation(fields: [wordCloudId], references: [id], onDelete: Cascade)
  submissions WordCloudSubmission[]

  @@unique([wordCloudId, text])
  @@index([wordCloudId])
  @@map("word_cloud_entries")
}

model WordCloudSubmission {
  id          String   @id @default(cuid())
  wordCloudId String   @map("word_cloud_id")
  entryId     String   @map("entry_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  wordCloud WordCloud      @relation(fields: [wordCloudId], references: [id], onDelete: Cascade)
  entry     WordCloudEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wordCloudId])
  @@index([userId])
  @@index([entryId])
  @@map("word_cloud_submissions")
}

// ============================================================================
// 7e. Scale — one live message holding one or more numeric agreement
// statements. min/max/labels are snapshotted per statement at publish time
// so editing a repository template can never change a published scale.
// ============================================================================

model Scale {
  id        String   @id @default(cuid())
  messageId String   @unique @map("message_id")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")

  message    Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  statements ScaleStatement[]

  @@map("scales")
}

model ScaleStatement {
  id         String @id @default(cuid())
  scaleId    String @map("scale_id")
  text       String
  order      Int
  min        Int    @default(0)
  max        Int    @default(5)
  leftLabel  String @default("Strongly disagree") @map("left_label")
  rightLabel String @default("Strongly agree") @map("right_label")

  scale     Scale           @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  responses ScaleResponse[]

  @@unique([scaleId, order])
  @@index([scaleId])
  @@map("scale_statements")
}

// One row per participant per statement. `value` is a real answer even when
// it is 0 — "not answered" is the absence of a row, never a zero.
model ScaleResponse {
  id          String   @id @default(cuid())
  statementId String   @map("statement_id")
  userId      String   @map("user_id")
  value       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  statement ScaleStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statementId, userId])
  @@index([userId])
  @@map("scale_responses")
}

// ============================================================================
// 8. InviteCode
// ============================================================================

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  groupId     String    @map("group_id")
  isActive    Boolean   @default(true) @map("is_active")
  usageCount  Int       @default(0) @map("usage_count")
  maxUsage    Int?      @map("max_usage")
  expiresAt   DateTime? @map("expires_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([createdById])
  @@index([isActive])
  @@index([expiresAt])
  @@map("invite_codes")
}

// ============================================================================
// 9. Notification
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// ============================================================================
// 10. AuditLog
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Prompt Bot
// ============================================================================

enum PromptMatrixKind {
  CORE
  TASK
  SKILL
}

model PromptMatrix {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String?
  kind        PromptMatrixKind
  isBuiltIn   Boolean                @default(false) @map("is_built_in")
  isActive    Boolean                @default(true) @map("is_active")
  createdById String?                @map("created_by_id")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  createdBy   User?                  @relation("PromptMatrixCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions   PromptMatrixQuestion[]
  sessions    PromptBotSession[]

  @@index([kind, isActive])
  @@map("prompt_matrices")
}

model PromptMatrixQuestion {
  id              String            @id @default(cuid())
  matrixId        String            @map("matrix_id")
  order           Int
  text            String
  guidance        String
  element         String?
  isActive        Boolean           @default(true) @map("is_active")
  matrix          PromptMatrix      @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  answers         PromptBotAnswer[]
  skillAnswers    SkillItemAnswer[]
  skillJobAnswers SkillJobAnswer[]

  @@index([matrixId, order])
  @@map("prompt_matrix_questions")
}

model PromptBotSession {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  title         String                 @default("Untitled prompt")
  basePrompt    String                 @map("base_prompt")
  taskMatrixId  String?                @map("task_matrix_id")
  taskDetected  Boolean                @default(true) @map("task_detected")
  scoreRevision Int                    @default(0) @map("score_revision")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  user          User                   @relation("PromptBotSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  taskMatrix    PromptMatrix?          @relation(fields: [taskMatrixId], references: [id], onDelete: SetNull)
  answers       PromptBotAnswer[]
  enhancements  PromptBotEnhancement[]

  @@index([userId, updatedAt])
  @@map("prompt_bot_sessions")
}

model PromptBotAnswer {
  id          String               @id @default(cuid())
  sessionId   String               @map("session_id")
  questionId  String               @map("question_id")
  answer      String               @default("")
  score       Int                  @default(0)
  reason      String?
  notRelevant Boolean              @default(false) @map("not_relevant")
  scoredAt    DateTime?            @map("scored_at")
  session     PromptBotSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question    PromptMatrixQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("prompt_bot_answers")
}

model PromptBotEnhancement {
  id                    String           @id @default(cuid())
  sessionId             String           @map("session_id")
  version               Int
  content               String
  unansweredQuestionIds String[]         @default([]) @map("unanswered_question_ids")
  model                 String
  instructionsVersion   String           @map("instructions_version")
  createdAt             DateTime         @default(now()) @map("created_at")
  session               PromptBotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@map("prompt_bot_enhancements")
}

model AiUsageDaily {
  userId  String @map("user_id")
  day     String
  feature String
  count   Int    @default(0)
  user    User   @relation("AiUsageOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, feature])
  @@map("ai_usage_daily")
}

model AiSettings {
  id        String   @id @default("singleton")
  limits    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

// ============================================================================
// Prompt Bot — Skills Builder
// ============================================================================

enum SkillItemKind {
  CUSTOM
  CATALOG
}

enum SkillItemStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

model SkillPack {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  title       String          @default("My skills")
  description String
  role        String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation("SkillPackOwner", fields: [userId], references: [id], onDelete: Cascade)
  items       SkillPackItem[]

  @@index([userId, updatedAt])
  @@map("skill_packs")
}

model SkillPackItem {
  id                  String             @id @default(cuid())
  packId              String             @map("pack_id")
  order               Int
  kind                SkillItemKind
  /// Deprecated 2026-11-25: unused since the Jobs redesign; kept so no data is dropped.
  catalogEntryId      String?            @map("catalog_entry_id")
  name                String
  purpose             String
  status              SkillItemStatus    @default(DRAFT)
  files               Json?
  validationErrors    String[]           @default([]) @map("validation_errors")
  scoreRevision       Int                @default(0) @map("score_revision")
  generationStartedAt DateTime?          @map("generation_started_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  pack                SkillPack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  catalogEntry        SkillCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  answers             SkillItemAnswer[]

  @@index([packId, order])
  @@map("skill_pack_items")
}

model SkillItemAnswer {
  id          String               @id @default(cuid())
  itemId      String               @map("item_id")
  questionId  String               @map("question_id")
  answer      String               @default("")
  score       Int                  @default(0)
  reason      String?
  notRelevant Boolean              @default(false) @map("not_relevant")
  scoredAt    DateTime?            @map("scored_at")
  item        SkillPackItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  question    PromptMatrixQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([itemId, questionId])
  @@map("skill_item_answers")
}

/// Deprecated 2026-11-25: unused since the Jobs redesign; kept so no data is dropped.
model SkillCatalogEntry {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  description  String
  sourceUrl    String          @map("source_url")
  license      String
  bundlable    Boolean         @default(false)
  installNotes String          @map("install_notes")
  tags         String[]        @default([])
  isActive     Boolean         @default(true) @map("is_active")
  createdById  String?         @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    User?           @relation("SkillCatalogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        SkillPackItem[]

  @@map("skill_catalog_entries")
}

// ============================================================================
// Prompt Bot — Skills Builder jobs (2026-11-25 redesign)
// ============================================================================

enum SkillJobFileKind {
  PPTX
  DOCX
  XLSX
  PDF
  PNG
  JPEG
}

enum SkillAnalysisStatus {
  PENDING
  READY
  FAILED
}

model SkillJob {
  id                        String               @id @default(cuid())
  userId                    String               @map("user_id")
  title                     String               @default("Untitled job")
  description               String               @default("")
  scoreRevision             Int                  @default(0) @map("score_revision")
  suggestedAt               DateTime?            @map("suggested_at")
  /// When the task's questions were last written (null until then; migrated jobs: their creation time).
  questionsGeneratedAt      DateTime?            @map("questions_generated_at")
  /// The output type inferred when questions were last written, e.g. "Instagram carousel" (<= 60 chars).
  outputType                String?              @map("output_type")
  /// Plugins (spec 2026-11-25 plugins): company or team, <= 80; "" = none.
  company                   String               @default("")
  /// The plugin id as the user set it; null = the default (follows company and title).
  pluginName                String?              @map("plugin_name")
  /// null = the default display name.
  pluginDisplayName         String?              @map("plugin_display_name")
  pluginStatus              SkillItemStatus      @default(DRAFT) @map("plugin_status")
  pluginValidationErrors    String[]             @default([]) @map("plugin_validation_errors")
  pluginGenerationStartedAt DateTime?            @map("plugin_generation_started_at")
  pluginLatestVersion       Int                  @default(0) @map("plugin_latest_version")
  pluginVersions            SkillPluginVersion[]
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  user                      User                 @relation("SkillJobOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Read only by the tasks data migration; nothing writes it any more.
  answers                   SkillJobAnswer[]
  questions                 SkillJobQuestion[]
  files                     SkillJobFile[]
  skills                    SkillJobSkill[]

  @@index([userId, updatedAt])
  @@map("skill_jobs")
}

model SkillJobAnswer {
  id          String               @id @default(cuid())
  jobId       String               @map("job_id")
  questionId  String               @map("question_id")
  answer      String               @default("")
  score       Int                  @default(0)
  reason      String?
  notRelevant Boolean              @default(false) @map("not_relevant")
  scoredAt    DateTime?            @map("scored_at")
  job         SkillJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question    PromptMatrixQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([jobId, questionId])
  @@index([questionId])
  @@map("skill_job_answers")
}

model SkillJobFile {
  id                String              @id @default(cuid())
  jobId             String              @map("job_id")
  /// As uploaded, for display only.
  fileName          String              @map("file_name")
  /// Server-made safe name: the file's name under assets/.
  assetName         String              @map("asset_name")
  kind              SkillJobFileKind
  /// Canonical for the kind, never the browser's claim.
  mimeType          String              @map("mime_type")
  size              Int
  sha256            String
  data              Bytes
  /// Deterministic extraction (FileFacts).
  facts             Json?
  /// Readable style guide: the AI's, or the user's edit.
  analysis          String?
  analysisStatus    SkillAnalysisStatus @default(PENDING) @map("analysis_status")
  analysisStartedAt DateTime?           @map("analysis_started_at")
  analysisEdited    Boolean             @default(false) @map("analysis_edited")
  analysisError     String?             @map("analysis_error")
  /// Removed from the job but kept while an older version bundles it.
  deletedAt         DateTime?           @map("deleted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  job               SkillJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// The FIXED question this file answers; null = a general file.
  questionId        String?             @map("question_id")
  question          SkillJobQuestion?   @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([jobId, assetName])
  @@index([jobId, createdAt])
  @@index([questionId])
  @@map("skill_job_files")
}

enum SkillQuestionSource {
  AI
  USER
}

enum SkillQuestionKind {
  /// Same every time: answered now (text + files) and baked into the skill.
  FIXED
  /// Varies each run: not answered now; the skill asks for it at the start of every run.
  PER_USE
}

enum SkillFileHint {
  /// Reference or past example.
  REFERENCE
  /// Typical input data.
  INPUT
  /// Template or design system.
  TEMPLATE
  /// Brand assets.
  BRAND
}

model SkillJobQuestion {
  id               String              @id @default(cuid())
  jobId            String              @map("job_id")
  order            Int
  text             String
  guidance         String              @default("")
  wantsFiles       Boolean             @default(false) @map("wants_files")
  fileHint         SkillFileHint?      @map("file_hint")
  /// A specific upload prompt when the question asks for files, e.g. "Upload your logo and brand colours".
  fileNote         String              @default("") @map("file_note")
  source           SkillQuestionSource @default(AI)
  kind             SkillQuestionKind   @default(FIXED)
  /// PER_USE only: Claude must have this before it starts (false = ask, but it may proceed without it).
  required         Boolean             @default(true)
  /// The skill-definition question this row was migrated from (jobs made before tasks), else null.
  legacyQuestionId String?             @map("legacy_question_id")
  answer           String              @default("")
  score            Int                 @default(0)
  reason           String?
  scoredAt         DateTime?           @map("scored_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  job              SkillJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  files            SkillJobFile[]

  @@index([jobId, order])
  @@map("skill_job_questions")
}

model SkillJobSkill {
  id                  String          @id @default(cuid())
  jobId               String          @map("job_id")
  order               Int
  /// Kebab-case; owns the folder of the next version.
  name                String
  purpose             String
  fileIds             String[]        @default([]) @map("file_ids")
  status              SkillItemStatus @default(DRAFT)
  validationErrors    String[]        @default([]) @map("validation_errors")
  generationStartedAt DateTime?       @map("generation_started_at")
  latestVersion       Int             @default(0) @map("latest_version")
  /// Plugins: MAIN runs the whole job and orchestrates every SUB.
  role                SkillRole       @default(SUB)
  /// Display label <= 60, e.g. "Grammar check".
  label               String          @default("")
  /// Sub-skill: what it does and what it leaves to the main skill, <= 600.
  focus               String          @default("")
  /// Sub-skill: its line in the main workflow, <= 160.
  step                String          @default("")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  job                 SkillJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  versions            SkillVersion[]

  @@unique([jobId, name])
  @@index([jobId, order])
  @@map("skill_job_skills")
}

/// Immutable: nothing updates a version row.
model SkillVersion {
  id           String        @id @default(cuid())
  skillId      String        @map("skill_id")
  version      Int
  /// The folder and SKILL.md name of this version.
  name         String
  description  String
  /// Text files: [{ path, content }].
  files        Json
  /// Bundled originals: [{ fileId, path, fileName, bytes }].
  assets       Json
  /// The same ids as `assets`, for indexed lookups.
  assetFileIds String[]      @default([]) @map("asset_file_ids")
  createdAt    DateTime      @default(now()) @map("created_at")
  skill        SkillJobSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@map("skill_versions")
}

enum SkillRole {
  MAIN
  SUB
}

/// One immutable, self-contained plugin version: every text file plus asset entries.
model SkillPluginVersion {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  version      Int
  /// The plugin id at this version.
  name         String
  displayName  String   @map("display_name")
  /// [{ name, role, label, purpose, description, files: [{ path, content }] }], main first.
  skills       Json
  /// Plugin-level text files: .claude-plugin/plugin.json, commands/*.md.
  files        Json
  /// [{ fileId, skill, path, fileName, bytes }]: bundled originals per skill.
  assets       Json
  assetFileIds String[] @default([]) @map("asset_file_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  job          SkillJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, version])
  @@map("skill_plugin_versions")
}

// ============================================================================
// 11. Workshop registration / demo payment / verification
// ============================================================================

// Payment is never verified inside this application — the participant
// self-reports by clicking "Payment Done"; an admin follows up outside
// the app. There is intentionally no "approved"/"rejected" state here.
enum RegistrationStatus {
  PENDING_PAYMENT
  PAYMENT_DONE
}

enum WorkshopPackage {
  DAY1
  DAY2
  BOTH
}

enum AiExperienceLevel {
  NEW
  SOMETIMES
  DAILY
}

// Whether this registration was submitted via the Individual or Company
// path on the registration form. Each registrant — company-affiliated or
// not — still gets exactly one of these rows; this never implies bulk /
// multi-attendee registration.
enum RegistrationKind {
  INDIVIDUAL
  COMPANY
}

model WorkshopRegistration {
  id                     String             @id @default(cuid())
  registrationCode       String             @unique @map("registration_code")
  registrationKind       RegistrationKind   @default(INDIVIDUAL) @map("registration_kind")
  fullName               String             @map("full_name")
  email                  String
  whatsappNumber         String             @map("whatsapp_number")
  // Free-text organisation name, collected only for an Individual
  // registration (optional there). Company registrations carry their
  // company identity in companyName/companyAddress/companyGstin below —
  // kept separate from participant identity per the business's request,
  // and separate again from gstCompanyName/gstin, which back the
  // unrelated "need a GST invoice" toggle available to either kind.
  company                String?
  designation            String
  workshopPackage        WorkshopPackage    @map("workshop_package")
  previousDay1Attendance Boolean?           @map("previous_day1_attendance")
  previousDay1When       String?            @map("previous_day1_when")
  aiExperienceLevel      AiExperienceLevel  @map("ai_experience_level")
  aiUseCase              String?            @map("ai_use_case")
  subscriptions          String[]           @default([])
  needsGstInvoice        Boolean            @default(false) @map("needs_gst_invoice")
  gstCompanyName         String?            @map("gst_company_name")
  gstin                  String?
  // Company-registration-only identity fields (null for Individual).
  companyName            String?            @map("company_name")
  companyAddress         String?            @map("company_address")
  companyGstin           String?            @map("company_gstin")
  referredBy             String?            @map("referred_by")
  ageConfirmed           Boolean            @map("age_confirmed")
  amountInInr            Int                @map("amount_in_inr")
  status                 RegistrationStatus @default(PENDING_PAYMENT)
  // Set once, the moment the participant clicks "Payment Done" on their
  // own payment page. There is no admin verification step — this
  // timestamp plus `status` is the entire payment record; an admin
  // follows up with the participant outside the application.
  paymentMarkedDoneAt    DateTime?          @map("payment_marked_done_at")
  // Set by an admin after checking the money actually arrived; separate
  // from the participant's own claim above. Null means not yet verified,
  // which is how every registration starts.
  paymentVerifiedAt      DateTime?          @map("payment_verified_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("workshop_registrations")
}

// ============================================================================
// 12. Forms platform — builder, question repository, chat delivery,
// feedback, analytics (Modules F-K)
// ============================================================================

enum FormCategory {
  GENERIC
  FEEDBACK
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormQuestionType {
  SHORT_ANSWER
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  LINEAR_SCALE
  STAR_RATING
  DATE
  TIME
  FILE_UPLOAD
  MULTIPLE_CHOICE_GRID
  CHECKBOX_GRID
}

enum FormInvitationStatus {
  SENT
  OPENED
  SUBMITTED
}

model Form {
  id                       String       @id @default(cuid())
  title                    String
  description              String?
  headerImageUrl           String?      @map("header_image_url")
  themeColor               String?      @map("theme_color")
  category                 FormCategory @default(GENERIC)
  status                   FormStatus   @default(DRAFT)
  createdById              String       @map("created_by_id")
  opensAt                  DateTime?    @map("opens_at")
  closesAt                 DateTime?    @map("closes_at")
  allowMultipleSubmissions Boolean      @default(false) @map("allow_multiple_submissions")
  feedbackTargetType       String?      @map("feedback_target_type")
  feedbackTargetLabel      String?      @map("feedback_target_label")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sections    FormSection[]
  invitations FormInvitation[]
  responses   FormResponse[]

  @@index([createdById])
  @@index([status])
  @@index([category])
  @@map("forms")
}

model FormSection {
  id          String  @id @default(cuid())
  formId      String  @map("form_id")
  title       String?
  description String?
  order       Int

  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  questions FormQuestion[]

  @@unique([formId, order])
  @@map("form_sections")
}

model FormQuestion {
  id          String           @id @default(cuid())
  sectionId   String           @map("section_id")
  templateId  String?          @map("template_id")
  type        FormQuestionType
  title       String
  description String?
  required    Boolean          @default(false)
  order       Int
  // Per-type shape: options (string[]) for MULTIPLE_CHOICE/CHECKBOXES/
  // DROPDOWN/grid column labels; rows (string[]) for grid types; min/max
  // for LINEAR_SCALE; maxLength for SHORT_ANSWER/PARAGRAPH; allowOther
  // (boolean) for choice types; showIf ({questionId, value}) for the
  // minimal conditional-display support described in the design doc.
  config      Json             @default("{}")

  section  FormSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  template FormQuestionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  answers  FormAnswer[]

  @@unique([sectionId, order])
  @@index([templateId])
  @@map("form_questions")
}

model FormQuestionTemplate {
  id          String           @id @default(cuid())
  title       String
  type        FormQuestionType
  description String?
  config      Json             @default("{}")
  category    String?
  tags        String[]         @default([])
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions FormQuestion[]

  @@index([createdById])
  @@index([type])
  @@index([category])
  @@map("form_question_templates")
}

model FormInvitation {
  id              String               @id @default(cuid())
  formId          String               @map("form_id")
  messageId       String?              @map("message_id")
  groupId         String?              @map("group_id")
  recipientUserId String               @map("recipient_user_id")
  status          FormInvitationStatus @default(SENT)
  sentAt          DateTime             @default(now()) @map("sent_at")
  openedAt        DateTime?            @map("opened_at")
  submittedAt     DateTime?            @map("submitted_at")

  form      Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  message   Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipient User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  response  FormResponse?

  @@index([formId])
  @@index([recipientUserId])
  @@index([messageId])
  @@map("form_invitations")
}

model FormResponse {
  id               String   @id @default(cuid())
  formId           String   @map("form_id")
  invitationId     String?  @unique @map("invitation_id")
  respondentUserId String?  @map("respondent_user_id")
  anonymous        Boolean  @default(false)
  submittedAt      DateTime @default(now()) @map("submitted_at")

  form       Form            @relation(fields: [formId], references: [id], onDelete: Cascade)
  invitation FormInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  respondent User?           @relation(fields: [respondentUserId], references: [id], onDelete: SetNull)
  answers    FormAnswer[]

  @@index([formId])
  @@index([respondentUserId])
  @@map("form_responses")
}

model FormAnswer {
  id         String @id @default(cuid())
  responseId String @map("response_id")
  questionId String @map("question_id")
  // Generic per-type shape: string | string[] | number | Record<row,
  // value> for grids | { fileId } for FILE_UPLOAD (see FormAnswerFile).
  value      Json

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
  @@map("form_answers")
}

model FormAnswerFile {
  id        String   @id @default(cuid())
  mimeType  String   @map("mime_type")
  fileName  String   @map("file_name")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("form_answer_files")
}
